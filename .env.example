# ─────────────────────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# ── General ──
NODE_ENV=development
APP_URL=http://localhost:3000          # web app
API_URL=http://localhost:4000          # API
CORS_ORIGINS=http://localhost:3000

# ── Database (local docker) ──
DATABASE_URL=postgresql://lms:lms_dev_password@localhost:5432/lms?schema=public

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── Auth ──
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
MAX_ACTIVE_DEVICES_PER_STUDENT=2

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ── SMS OTP (Sri Lankan provider, e.g. Notify.lk / Text.lk / Dialog) ──
SMS_PROVIDER=console                   # console = log OTP to terminal in dev
SMS_API_KEY=
SMS_SENDER_ID=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ── Email (local: Mailpit at http://localhost:8025) ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LMS <no-reply@lms.local>"

# ── Object storage (local: MinIO at http://localhost:9001) ──
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=lms_minio
STORAGE_SECRET_KEY=lms_minio_password
STORAGE_BUCKET_PRIVATE=lms-private
SIGNED_URL_TTL_SECONDS=300

# ── PayHere ──
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
PAYHERE_NOTIFY_URL=http://localhost:4000/api/v1/payments/payhere/notify
PAYHERE_RETURN_URL=http://localhost:3000/payments/success
PAYHERE_CANCEL_URL=http://localhost:3000/payments/cancel

# ── Video access ──
# Signs the short-lived token a student needs to fetch a lesson's YouTube ID
VIDEO_TOKEN_SECRET=change_me
VIDEO_TOKEN_TTL_SECONDS=120

# ── Web (public, exposed to browser) ──
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ── Mobile (public, bundled into the app) ──
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api/v1   # Android emulator → host machine
